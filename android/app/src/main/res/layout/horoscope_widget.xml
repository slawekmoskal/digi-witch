<?xml version="1.0" encoding="utf-8"?>
<!-- "Today for you": sign and date, the day's line, meters (or caution), day number and colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/day_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:letterSpacing="0.05"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#F1D98A"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- The day's warm headline from the meters; gone when the app sent none. -->
    <TextView
        android:id="@+id/w_cheer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/w_caution"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#E3D9C2"
        android:textSize="12sp" />

    <!-- Love, work, energy: label over five dots. Hidden when the day has no meters. -->
    <LinearLayout
        android:id="@+id/w_meters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/w_love"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textColor="#E3D9C2"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_work"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textColor="#E3D9C2"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_energy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textColor="#E3D9C2"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F1D98A"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
