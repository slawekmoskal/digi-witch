<?xml version="1.0" encoding="utf-8"?>
<!-- Your day (large): headline, the day's line, meters, card and Moon, day number. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/day_widget_bg"
    android:gravity="top"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/w_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F1D98A"
        android:textSize="11sp" android:textStyle="bold"
        android:letterSpacing="0.05"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/w_cheer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="#FFFFFF"
        android:textSize="20sp" android:textStyle="bold"
        android:fontFamily="serif" />

    <TextView
        android:id="@+id/w_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="#F1D98A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/w_meters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_love"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textColor="#F3E9D2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/w_work"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textColor="#F3E9D2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_energy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textColor="#F3E9D2"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- The day's line fills the space above the card. -->
    <TextView
        android:id="@+id/w_line"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="4"
        android:textColor="#F3E9D2"
        android:textSize="14sp" />

    <!-- Card of the day and the Moon side by side. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_card_img"
            android:layout_width="44dp"
            android:layout_height="76dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/w_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_moon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="#F3E9D2"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F1D98A"
        android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
