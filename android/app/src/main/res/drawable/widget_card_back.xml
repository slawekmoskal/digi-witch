<?xml version="1.0" encoding="utf-8"?>
<!-- The card's back, shown until the card of the day is turned in the app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#6B5C9E" android:endColor="#3D336B"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape>
            <corners android:radius="4dp"/>
            <stroke android:width="1dp" android:color="#C9A44C"/>
        </shape>
    </item>
</layer-list>
